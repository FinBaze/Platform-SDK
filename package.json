{
  "name": "@finbaze/platform-sdk",
  "version": "1.1.0",
  "description": "FinBaze platform SDK: companies, users, embed sessions, webhooks and the v2 GraphQL API.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./graphql": {
      "import": {
        "types": "./dist/graphql.d.ts",
        "default": "./dist/graphql.js"
      },
      "require": {
        "types": "./dist/graphql.d.cts",
        "default": "./dist/graphql.cjs"
      }
    },
    "./operations": {
      "import": {
        "types": "./dist/operations.d.ts",
        "default": "./dist/operations.js"
      },
      "require": {
        "types": "./dist/operations.d.cts",
        "default": "./dist/operations.cjs"
      }
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "codegen": "tsx scripts/generate-operations.ts && graphql-codegen --config codegen.ts",
    "build": "npm run codegen && tsup",
    "dev": "tsup --watch",
    "test": "jest --config jest.config.cjs --watchman=false",
    "lint": "echo \"(no lint configured)\" && exit 0",
    "clean": "rm -rf dist src/generated",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs",
    "attw": "attw --pack . --profile node16",
    "generate:operations": "tsx scripts/generate-operations.ts"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@graphql-codegen/cli": "^7.1.0",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "change-case-all": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
